create table quick_products (
  id text primary key,
  name text not null,
  category_slug text not null,
  price numeric(10,2) not null,
  compare_at_price numeric(10,2),
  unit text not null,
  description text,
  image text,
  emoji text default '🛒',
  is_best_seller boolean not null default false,
  created_at timestamptz not null default now()
);

alter table quick_products enable row level security;

create policy "public read" on quick_products for select using (true);
create policy "public insert" on quick_products for insert with check (true);
create policy "public delete" on quick_products for delete using (true);
create policy "public update" on quick_products for update using (true);
